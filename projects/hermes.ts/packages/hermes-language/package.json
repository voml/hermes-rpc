{
    "name": "@yydb/hermes-language",
    "version": "0.0.3",
    "description": "Browser-facing Hermes RPC helpers backed by the `hermes-wasm` binding",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "readme.md"
    ],
    "scripts": {
        "build": "node ./scripts/build-dist.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "node --experimental-strip-types --test \"./tests/**/*.test.ts\""
    },
    "dependencies": {
        "@yydb/hermes-unknown-wasm32": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.9.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/hermes-rpc.git",
        "directory": "projects/hermes.ts/packages/hermes-language"
    }
}
