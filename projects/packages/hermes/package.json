{
    "name": "@yydb/hermes",
    "version": "0.1.0",
    "description": "Hermes RPC runtime — VOS operation artifact loader and dispatch for Node.js (N-API + WASM facade)",
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist", "README.md"],
    "dependencies": {
        "@yydb/hermes-unknown-wasm32": "workspace:*"
    },
    "optionalDependencies": {
        "@yydb/hermes-darwin-arm64": "workspace:*",
        "@yydb/hermes-darwin-x64": "workspace:*",
        "@yydb/hermes-linux-arm64": "workspace:*",
        "@yydb/hermes-linux-x64": "workspace:*",
        "@yydb/hermes-win32-x64": "workspace:*"
    },
    "publishConfig": { "access": "public" },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/hermes-rpc.git",
        "directory": "projects/packages/hermes"
    }
