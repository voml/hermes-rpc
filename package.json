{
    "private": true,
    "packageManager": "pnpm@10.0.0",
    "scripts": {
        "build": "cargo build --release",
        "build:wasm": "node scripts/build-wasm.mjs",
        "typecheck:ts": "pnpm -r --filter @yydb/hermes-language --filter @yydb/hermes-unknown-wasm32 run typecheck",
        "test:ts": "pnpm -r --filter @yydb/hermes-language --filter @yydb/hermes-unknown-wasm32 run test",
        "test": "cargo test --release",
        "fmt": "cargo fmt --all",
        "push": "wee test && git push",
        "reset": "git reset Head~ --soft",
        "u": "cargo upgrade --workspace"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.1.9",
        "@napi-rs/cli": "^2.16",
        "typescript": "^5.9.2"
    }
}
